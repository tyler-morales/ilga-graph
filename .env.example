# ILGA Graph – environment variables
# Copy to .env and uncomment what you need.

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  PROFILE — the only variable most people need                            ║
# ║                                                                          ║
# ║  dev  → seed mode ON, dev mode ON, CORS *, lighter scrape limits         ║
# ║  prod → seed OFF, dev OFF, CORS must be set, warns if API_KEY is empty   ║
# ╚════════════════════════════════════════════════════════════════════════════╝
ILGA_PROFILE=dev

# ── Everything below is optional — overrides the profile when set ────────────

# Session (104th GA 2025–2026)
# ILGA_GA_ID=18
# ILGA_SESSION_ID=114

# Security (required for prod)
# ILGA_CORS_ORIGINS=https://landofkei.org   # or add https://www.landofkei.org if you use both
# ILGA_API_KEY=
# ILGA_CSP_REPORT_URI=   # optional; CSP violation report endpoint
# ILGA_CSP_ENFORCE=0     # 1 = enforcing CSP; 0 = report-only (default)
# ILGA_HSTS_ENABLED=0    # 1 = send HSTS (only when site is fully HTTPS)

# Mode overrides (normally set by the profile)
# ILGA_DEV_MODE=1
# ILGA_SEED_MODE=1   # 0 = use full cache + Census ZIPs (e.g. after make scrape; see make dev-full)
# ILGA_INCREMENTAL=0
# ILGA_LOAD_ONLY=1  # API loads from cache only (no scrape). make dev / make run set this.

# Paths
# ILGA_BASE_URL=https://www.ilga.gov/
# Required in production so share cards work: set to your public HTTPS URL (no trailing slash).
# If unset, og:image and og:url point to http://127.0.0.1:8000 and crawlers cannot fetch the image.
# ILGA_APP_BASE_URL=https://landofkei.org
# ILGA_DOCS_BASE_URL=
# ILGA_CACHE_DIR=cache
# ILGA_MOCK_DIR=mocks/dev

# SEO & share (Open Graph, canonical; optional overrides)
# Advocacy group / site brand: used in UI, footer, share cards, and verification emails.
# ILGA_SITE_NAME=The Land of Kei
# ILGA_META_DESCRIPTION=Find your Illinois legislators and advocate with The Land of Kei for a statutory fix...
# ILGA_OG_IMAGE_URL=   # Optional; default is APP_BASE_URL/static/og-image.png. Set ILGA_APP_BASE_URL in prod so image URL is reachable.

# Analytics (Umami Cloud). Script loads only when ILGA_PROFILE=prod and this is set.
# Sign up at https://umami.is → Websites → Add website → copy the website ID (UUID) here.
# Set in production .env only so dev is not tracked.
# ILGA_UMAMI_WEBSITE_ID=your-website-id-uuid-from-umami-dashboard
# ILGA_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js   # Override for self-hosted Umami

# Beta banner (site-wide “new site, may have bugs” bar; dismissible per session). Set to 0 when leaving beta.
ILGA_BETA_BANNER=1
# Report a bug: link goes to in-app form at /report-bug unless FEEDBACK_URL is set.
# ILGA_BETA_BANNER_EMAIL=feedback@landofkei.org   # notification recipient when form is submitted (requires SMTP)
# ILGA_BETA_BANNER_FEEDBACK_URL=                  # override link to external URL (e.g. Google Form)
# ILGA_BUG_REPORT_UPLOAD_DIR=data/bug_report_uploads
# ILGA_BUG_REPORT_MAX_IMAGE_MB=5
# Rate limits (in-memory; resets on restart). Protects bug report and auth from spam/brute-force.
# ILGA_RATE_LIMIT_BUG_REPORT_PER_HOUR=10
# ILGA_RATE_LIMIT_REQUEST_CODE_PER_15MIN=3
# ILGA_RATE_LIMIT_VERIFY_CODE_PER_15MIN=10
# Cloudflare Turnstile (optional; free 1M/mo). Get keys: https://dash.cloudflare.com → Turnstile.
# ILGA_TURNSTILE_SITE_KEY=
# ILGA_TURNSTILE_SECRET_KEY=

# Scrape limits
# ILGA_MEMBER_LIMIT=0
# ILGA_TEST_MEMBER_URL=
# ILGA_TEST_MEMBER_CHAMBER=Senate

# Bill list for votes + witness slips (comma-separated URLs)
# ILGA_VOTE_BILL_URLS=

# ── Auth + outreach DB ────────────────────────────────────────────────────────
# DB path is set by profile when unset: dev → data/ilga_dev.db (sandbox), prod → data/ilga.db (live).
# Override to use a single DB or a custom path:
# ILGA_DB_PATH=data/ilga.db

# Session signing secret (generate a random string for prod!)
# ILGA_AUTH_SECRET=change-me-in-production
# ILGA_AUTH_COOKIE_MAX_AGE=2592000   # seconds (default 30 days)
# Admin: comma-separated emails allowed to access /admin/updates (compose and send campaign updates).
# ILGA_ADMIN_EMAILS=your-email@example.com

# ── Brevo (recommended: free tier 300 emails/day) ─────────────────────────────
# If ILGA_SMTP_HOST is unset (or all SMTP lines commented out), verification codes are logged to the
# terminal only — no email is sent. Uncomment and set below to send real emails via Brevo.
# Brevo → Settings → SMTP & API → SMTP tab. Copy BOTH "SMTP login" (username) and "SMTP key" (password).
# ILGA_SMTP_USER must be the SMTP login shown there — NOT your Brevo account email.
# Put these in .env (gitignored) or your host's env; never commit the real key.
# ILGA_SMTP_HOST=smtp-relay.brevo.com
# ILGA_SMTP_PORT=587
# ILGA_SMTP_USER=a2c1c7001@smtp-brevo.com
# ILGA_SMTP_PASS=API_KEY
# ILGA_SMTP_FROM=noreply@landofkei.org
# ILGA_SMTP_TLS=1

# ── Feature flags (client-side UX) ─────────────────────────────────────────
# Defaults follow ILGA_PROFILE (dev=on, prod=off). Override with ILGA_FEATURE_* (config.py _FEATURE_REGISTRY).
# ILGA_FEATURE_MESSAGE_MARQUEE=1
# ILGA_FEATURE_IMAGES_MARQUEE=1