# ILGA Graph – environment variables
# Copy to .env and uncomment what you need.

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  PROFILE — the only variable most people need                            ║
# ║                                                                          ║
# ║  dev  → seed mode ON, dev mode ON, CORS *, lighter scrape limits         ║
# ║  prod → seed OFF, dev OFF, CORS must be set, warns if API_KEY is empty   ║
# ╚════════════════════════════════════════════════════════════════════════════╝
ILGA_PROFILE=dev

# ── Everything below is optional — overrides the profile when set ────────────

# Session (104th GA 2025–2026)
# ILGA_GA_ID=18
# ILGA_SESSION_ID=114

# Security (required for prod)
# ILGA_CORS_ORIGINS=https://landofkei.org   # or add https://www.landofkei.org if you use both
# ILGA_API_KEY=

# Mode overrides (normally set by the profile)
# ILGA_DEV_MODE=1
# ILGA_SEED_MODE=1   # 0 = use full cache + Census ZIPs (e.g. after make scrape; see make dev-full)
# ILGA_INCREMENTAL=0
# ILGA_LOAD_ONLY=1  # API loads from cache only (no scrape). make dev / make run set this.

# Paths
# ILGA_BASE_URL=https://www.ilga.gov/
# ILGA_CACHE_DIR=cache
# ILGA_MOCK_DIR=mocks/dev

# Scrape limits
# ILGA_MEMBER_LIMIT=0
# ILGA_TEST_MEMBER_URL=
# ILGA_TEST_MEMBER_CHAMBER=Senate

# Bill list for votes + witness slips (comma-separated URLs)
# ILGA_VOTE_BILL_URLS=

# ── Auth + outreach DB ────────────────────────────────────────────────────────
# DB path is set by profile when unset: dev → data/ilga_dev.db (sandbox), prod → data/ilga.db (live).
# Override to use a single DB or a custom path:
# ILGA_DB_PATH=data/ilga.db

# Session signing secret (generate a random string for prod!)
# ILGA_AUTH_SECRET=change-me-in-production

# ── Brevo (recommended: free tier 300 emails/day) ─────────────────────────────
# If ILGA_SMTP_HOST is unset (or all SMTP lines commented out), verification codes are logged to the
# terminal only — no email is sent. Uncomment and set below to send real emails via Brevo.
# Brevo → Settings → SMTP & API → SMTP tab. Copy BOTH "SMTP login" (username) and "SMTP key" (password).
# ILGA_SMTP_USER must be the SMTP login shown there — NOT your Brevo account email.
# Put these in .env (gitignored) or your host's env; never commit the real key.
# ILGA_SMTP_HOST=smtp-relay.brevo.com
# ILGA_SMTP_PORT=587
# ILGA_SMTP_USER=a2c1c7001@smtp-brevo.com
# ILGA_SMTP_PASS=API_KEY
# ILGA_SMTP_FROM=noreply@landofkei.org
# ILGA_SMTP_TLS=1

# ── Feature flags (client-side UX) ─────────────────────────────────────────
# Defaults follow ILGA_PROFILE (dev=on, prod=off for e.g. zip loading animation).
# Override with ILGA_FEATURE_* (see config.py _FEATURE_REGISTRY).
ILGA_FEATURE_ZIP_LOADING_ANIMATION=1