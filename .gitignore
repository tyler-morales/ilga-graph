# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Environment variables (keep .env.example committed)
.env
.env.*
!.env.example

# IDE / editor
.idea/
.vscode/
.cursor/debug-*.log
.cursor/plans/
.pr-body.md
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Project
name_map.json
cache/
cache.bak/
data/
.startup_timings.csv
.run_log.jsonl

# ML pipeline outputs (regenerate with make ml-pipeline / ml-resolve / ml-predict)
processed/*.parquet
processed/*.pkl
processed/*.json
processed/*.npz
!processed/.gitkeep

# Obsidian vault: generated by export_vault(); regenerate with make export or --export
ILGA_Graph_Vault/

# MkDocs build output (make docs)
site/

# Audit reports (generated by scripts/audit_*.py; use --report to regenerate)
audit_css_report.txt
audit_js_report.txt
audit_template_reachability_report.txt

# Seed data: mocks/dev/ is committed so "make dev" works without cache or network.
# Do NOT add mocks/ here.

# Campaign update images: admin uploads at compose time; do not commit (directory kept via .gitkeep)
src/ilga_graph/static/updates/*.jpg
src/ilga_graph/static/updates/*.png
src/ilga_graph/static/updates/*.webp
!src/ilga_graph/static/updates/.gitkeep

# Community story images: user uploads; do not commit (directory kept via .gitkeep)
src/ilga_graph/static/uploads/stories/*.jpg
src/ilga_graph/static/uploads/stories/*.png
src/ilga_graph/static/uploads/stories/*.webp
!src/ilga_graph/static/uploads/stories/.gitkeep
